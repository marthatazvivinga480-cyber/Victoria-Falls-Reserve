PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/victoria-falls-reserve?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
NODE_ENV=development
# Use same-site deployment domains if browsers block third-party cookies.
COOKIE_SAME_SITE=lax

# Private admin password, 16–72 characters. Required to create a new admin or run admin:password.
# SEED_ADMIN_PASSWORD=

# Optional: if your network DNS cannot resolve Atlas SRV records. Process-local only.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
